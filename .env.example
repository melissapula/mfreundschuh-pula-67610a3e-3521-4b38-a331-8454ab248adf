# Copy to .env at the workspace root before running the api.

# Signing secret for JWTs. Any long random string in dev; a real deployment
# would pull this from a secrets manager, not source control.
JWT_SECRET=dev-only-change-me-1f8a9c2e4b6d7f01

# Access token lifetime, in seconds. 900 = 15 minutes.
JWT_EXPIRES_IN_SECONDS=900

# Path to the SQLite file, relative to the workspace root.
DB_PATH=data/db.sqlite

# Port the NestJS api listens on.
PORT=3000

# Comma-separated list of origins allowed to call the api (the Angular dev
# server by default).
CORS_ORIGIN=http://localhost:4200
